{
  "name": "hoelni-desktop",
  "productName": "Hoelni Client Suite",
  "version": "0.3.0",
  "description": "Hoelni Client Suite – desktop program (own window, tray, real Minecraft game windows)",
  "main": "loader.cjs",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "node ../scripts/build-installers.mjs --only suite"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "pe-library": "^2.0.1",
    "resedit": "^3.1.0"
  },
  "build": {
    "appId": "net.hoelni.clientsuite",
    "productName": "Hoelni Client Suite",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "loader.cjs",
      "main.cjs",
      "build/icon.png",
      "build/tray.png",
      "build/logo.png",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "bundle",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hoelni Client Suite"
    }
  }
}
