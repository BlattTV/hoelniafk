{
  "name": "hoelni-desktop",
  "productName": "Hoelni Client Suite",
  "version": "0.2.0",
  "description": "Hoelni Client Suite \u2013 desktop program (own window, tray, real Minecraft game windows)",
  "main": "main.cjs",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "prepare-backend": "node prepare-backend.cjs",
    "dist": "node prepare-backend.cjs && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "net.hoelni.clientsuite",
    "productName": "Hoelni Client Suite",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "build/icon.png",
      "build/tray.png",
      "build/logo.png"
    ],
    "extraResources": [
      {
        "from": "bundle",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hoelni Client Suite"
    }
  }
}
