{
  "name": "hoelni-client-suite",
  "version": "0.2.0",
  "description": "Hoelni Client Suite – Minecraft / Discord / Mail identity management for your own Minecraft server",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node dist/supervisor.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "tsx src/demo.ts",
    "test:unit": "vitest run --exclude \"tests/integration/**\"",
    "test:integration": "vitest run tests/integration",
    "vault": "node dist/cli/vault.js",
    "start:direct": "node dist/index.js",
    "test:e2e": "playwright test",
    "testserver": "node dist/testserver/cli.js",
    "bench": "node --import tsx src/bench/bench.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "flying-squid": "^1.12.0",
    "https-proxy-agent": "^9.1.0",
    "imapflow": "^2.1.0",
    "mailparser": "^3.9.29",
    "mineflayer": "^4.39.0",
    "nodemailer": "^10.0.11",
    "prismarine-auth": "^3.1.1",
    "socks": "^2.8.10",
    "socks-proxy-agent": "^10.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "hoodiecrow-imap": "^2.1.0",
    "smtp-server": "^3.19.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.0"
  }
}
